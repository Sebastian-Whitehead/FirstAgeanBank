{
  "name": "first-aegean-bank-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build --config frontend/vite.config.js frontend",
    "cf:build": "npm run build && node scripts/stage-cf-assets.mjs",
