    "cf:deploy": "npm run cf:build && wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "7.0.2",
    "vite": "^6.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
